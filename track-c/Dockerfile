FROM gcc:15@sha256:eb5e64286ad47187b32bda75c6b6916166ecb41da56559b8b09e0001748d2cce AS build
COPY src/main.cpp /src/main.cpp
RUN M=; if [ "$(uname -m)" = x86_64 ]; then M="-march=x86-64-v3"; fi; \
    g++ -O3 $M -std=c++17 -DNDEBUG -flto -pthread -static -s -o /src/solution /src/main.cpp

FROM debian:13-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
COPY --from=build /src/solution /app/solution
ENTRYPOINT ["/app/solution", "--data", "/data", "--out", "/out"]
